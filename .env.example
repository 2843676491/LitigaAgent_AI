# ---- 基础 ----
APP_ENV=dev
API_PREFIX=/api/v1

# ---- LLM：mock（默认，离线确定性） / openai（OpenAI 兼容协议，含火山方舟、vLLM、DeepSeek） ----
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30
LLM_MAX_CALLS_PER_HEARING=14

# ---- 检索 ----
EMBEDDER=hash            # hash | bge_m3
EMBED_DIM=384
BGE_M3_URL=
TOP_K_VECTOR=8
TOP_K_BM25=8
TOP_K_FINAL=6
RRF_K=60

# ---- 图与人工复核 ----
MAX_ROUNDS=3
MAX_REVISIONS=2
HITL_CONFIDENCE_THRESHOLD=0.72

# ---- 存储（生产可切换，业务代码零改动） ----
MILVUS_URI=                 # 留空=本地 milvus-lite；生产填 http://milvus:19530
STORAGE_BACKEND=local       # local | s3(预留)
CACHE_BACKEND=memory        # memory | redis(预留)
AUDIT_SECRET=dev-only-change-me
